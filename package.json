{
  "name": "autumn-serenity-theme",
  "displayName": "Autumn Serenity",
  "description": "Autumn dark theme, freshly updated (2026). Warm earthy tones, a cozy cabin-and-fire mood and an accessible palette for long coding sessions. Actively maintained — try it and share your feedback!",
  "version": "1.1.1",
  "publisher": "CarlesBusquetsDev",
  "license": "MIT",
  "type": "module",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "autumn",
    "serenity",
    "dark theme",
    "seasonal",
    "cozy",
    "forest"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Autumn Serenity Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/autumn-serenity-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "package": "npm run build && node -e \"import('node:fs').then(fs => fs.mkdirSync('dist', { recursive: true }))\" && vsce package --out dist/",
    "install:local": "npm run package && code --install-extension dist/autumn-serenity-theme-$npm_package_version.vsix --force",
    "publish": "npm run build && vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlesBusquetsDev/autumn-serenity-theme.git"
  },
  "bugs": {
    "url": "https://github.com/CarlesBusquetsDev/autumn-serenity-theme/issues"
  },
  "homepage": "https://github.com/CarlesBusquetsDev/autumn-serenity-theme#readme"
}
